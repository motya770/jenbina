# Firebase configuration
FIREBASE_API_KEY=your-api-key-here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef
FIREBASE_DATABASE_URL=

# OpenAI (existing)
OPENAI_API_KEY=your-openai-key

# Deep Emotional Mirror
OPENAI_CHAT_MODEL=openai-advanced
SERPAPI_API_KEY=your-serpapi-api-key

# Heartbeat (optional; defaults shown)
# JENBINA_BEAT_MINUTES=15
# JENBINA_MAX_BEATS_PER_DAY=80
# JENBINA_LLM_TIMEOUT_SECONDS=60
# JENBINA_DISABLE_SLEEP=0

# LangSmith (optional - for LLM call tracing/debugging)
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=jenbina
